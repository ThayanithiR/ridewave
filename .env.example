# Application Environment Configuration
APP_NAME=RideWave
APP_ENV=development
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (PostgreSQL with PostGIS)
DATABASE_URL=postgresql+psycopg://ridewave:ridewave_password@localhost:5432/ridewave_db
# For testing or without Docker PostGIS initially:
# TEST_DATABASE_URL=sqlite+aiosqlite:///./test.db

# Redis (Caching & Ephemeral GPS)
REDIS_URL=redis://localhost:6379/0

# AI Trip Assistant (Zero-Cost Free Tier)
AI_ENABLED=true
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# Spatial Search Configuration
MAX_MATCHING_RADIUS_KM=5.0
H3_RESOLUTION=8

# Kafka (Milestone 4 - Asynchronous events)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
